# DataWeaver AI Selenium E2E Configuration
# Copy this file to .env inside tests/selenium/ to override default settings

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Browser mode: set to false to see Chrome running visually
SELENIUM_HEADLESS=true
SELENIUM_BROWSER=chrome
SELENIUM_WINDOW_WIDTH=1920
SELENIUM_WINDOW_HEIGHT=1080

# Timeouts in seconds
SELENIUM_DEFAULT_TIMEOUT=10
SELENIUM_LONG_TIMEOUT=25

# Test account credentials (must be an active, verified account in your test database)
TEST_USER_EMAIL=test_researcher@dataweaver.ai
TEST_USER_PASSWORD=Password123!
TEST_USER_FULL_NAME=Dr. Test Researcher

# Dedicated test workspace defaults
TEST_WORKSPACE_NAME=E2E Test Workspace
TEST_WORKSPACE_DOMAIN=Medical Imaging
